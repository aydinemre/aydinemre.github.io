---
const {chapter,index} = Astro.props;
const nodes = chapter.type === 'states' ? ['Ready','Running','Waiting'] : chapter.type === 'race' ? ['Thread A','counter','Thread B'] : chapter.type === 'fork' ? ['Parent · 100','Bellek','Child · 101'] : chapter.type === 'eof' || chapter.type === 'pipe' ? ['Üretici','Buffer','Tüketici'] : chapter.type === 'kernel' ? ['User mode','Kontrollü giriş','Kernel mode'] : chapter.type === 'context' ? ['P context','CPU','Q context'] : chapter.type === 'threads' ? ['Thread T1','Ortak adres alanı','Thread T2'] : chapter.type === 'pool' ? ['Acceptor','Kuyruk','Workers'] : ['Başlangıç','Kaynak / durum','Sonuç'];
---
<div class="lab" data-kind={chapter.type} data-steps={JSON.stringify(chapter.steps)}>
  <div class="lab-head"><span class="lab-label">ETKİLEŞİMLİ İZ · {String(index+1).padStart(2,'0')}</span><span class="step-count">1 / {chapter.steps.length}</span></div>
  <svg viewBox="0 0 720 190" role="img" aria-label={`${chapter.title}: adım adım kavramsal animasyon`}>
    <defs><marker id={`arrow-${index}`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#769987"/></marker></defs>
    <path class="connection" d="M200 95 H290 M430 95 H520" marker-end={`url(#arrow-${index})`}/>
    {nodes.map((label,i)=><g class="scene-node" data-node={i}><rect x={20+i*250} y="45" width="180" height="100" rx="16"/><text x={110+i*250} y="88" text-anchor="middle">{label}</text><text class="node-value" x={110+i*250} y="114" text-anchor="middle">{i===0?'●':'○'}</text></g>)}
    <circle class="packet" cx="110" cy="95" r="7"/>
  </svg>
  <div class="caption" aria-live="polite" aria-atomic="true"><strong>{chapter.steps[0][0]}</strong><p>{chapter.steps[0][1]}</p></div>
  <div class="controls"><button class="prev" aria-label="Önceki animasyon adımı" disabled>←</button><button class="play">▶ Oynat</button><button class="next" aria-label="Sonraki animasyon adımı">→</button><button class="reset">Başa dön</button><label>Hız <select class="speed" aria-label="Animasyon hızı"><option value="2400">Yavaş</option><option value="1400" selected>Normal</option><option value="700">Hızlı</option></select></label></div>
  <div class="timeline" aria-label="Animasyon adımları">{chapter.steps.map((step,i)=><button class="dot" data-step={i} aria-label={`Adım ${i+1}: ${step[0]}`} aria-current={i===0?'step':undefined}>{i+1}</button>)}</div>
  <p class="model-note">Kavramsal model · Gerçek sistem ölçümü veya çalışan C kodu çıktısı değildir.</p>
  <noscript><ol>{chapter.steps.map(step=><li><strong>{step[0]}:</strong> {step[1]}</li>)}</ol></noscript>
</div>
<script>
const compact = window.matchMedia('(max-width: 550px)');
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll<HTMLElement>('.lab').forEach(lab=>{
  const steps=JSON.parse(lab.dataset.steps!); let current=0; let timer:ReturnType<typeof setInterval>|undefined;
  const button=(name:string)=>lab.querySelector<HTMLButtonElement>(`.${name}`)!;
  const stop=()=>{clearInterval(timer);timer=undefined;button('play').textContent='▶ Oynat';button('play').setAttribute('aria-pressed','false');};
  const render=()=>{
    lab.querySelector('.step-count')!.textContent=`${current+1} / ${steps.length}`;
    lab.querySelector('.caption strong')!.textContent=steps[current][0];lab.querySelector('.caption p')!.textContent=steps[current][1];
    button('prev').disabled=current===0;button('next').disabled=current===steps.length-1;
    lab.querySelectorAll('.dot').forEach((dot,i)=>{if(i===current)dot.setAttribute('aria-current','step');else dot.removeAttribute('aria-current');});
    let active=current%3;
    const routes:Record<string,number[]>={fork:[0,1,2,2,0],context:[1,0,2,1,1],threads:[1,0,2,0,1],pool:[0,1,2,2,1],race:[1,0,2,0,2],pipe:[0,1,2,2,2],eof:[2,0,0,2,2],memory:[0,0,2,0,1],zombie:[0,0,1,2,2],overview:[0,1,1,2,2],review:[0,0,1,1,2]};
    if(routes[lab.dataset.kind!])active=routes[lab.dataset.kind!][current];
    if(lab.dataset.kind==='states')active=[0,1,2,0,0][current];
    if(lab.dataset.kind==='kernel')active=[0,1,2,2,0][current];
    lab.querySelectorAll('.scene-node').forEach((node,i)=>{node.classList.toggle('active',i===active);node.classList.toggle('absent',lab.dataset.kind==='fork' && current===0 && i===2);let value=i===active?'●':'';
      if(lab.dataset.kind==='race')value=i===1?(current>=3?'1':'0'):i===0?(current>=1?'temp = '+(current>=3?'1':'0'):'—'):(current>=2?'temp = '+(current===4?'1':'0'):'—');
      if(lab.dataset.kind==='fork')value=i===0?'x = 10':i===2?(current===0?'Henüz yok':current>=3?'program: echo':current>=2?'x = 20':'x = 10'):(current>=3?'image → echo':'Copy-on-write');
      if(lab.dataset.kind==='context')value=i===1?(current<3?'P':'Q'):i===0?'PC 24 · R 7':'PC 80 · R 3';
      if(lab.dataset.kind==='eof')value=i===0?(current===4?'Kapalı':'Writer var'):i===1?(current===1?'Dolu':'Boş'):(current===4?'EOF':'Bekleyebilir');
      node.querySelector('.node-value')!.textContent=value;
    });
    const small=compact.matches;lab.querySelector('svg')!.setAttribute('viewBox',small?'0 0 240 420':'0 0 720 190');
    lab.querySelectorAll('.scene-node').forEach((node,i)=>node.setAttribute('transform',small?`translate(${-250*i},${130*i})`:'translate(0,0)'));
    lab.querySelector('.connection')!.setAttribute('d',small?'M110 145 V175 M110 275 V305':'M200 95 H290 M430 95 H520');
    const packet=lab.querySelector<SVGCircleElement>('.packet')!;packet.style.transform=small?`translateY(${active*130}px)`:`translateX(${active*250}px)`;
    if(current===steps.length-1)stop();
  };
  button('prev').onclick=()=>{stop();current=Math.max(0,current-1);render();};button('next').onclick=()=>{stop();current=Math.min(steps.length-1,current+1);render();};button('reset').onclick=()=>{stop();current=0;render();};
  const play=()=>{if(timer){stop();return;}if(current===steps.length-1)current=0;render();button('play').textContent='Ⅱ Duraklat';button('play').setAttribute('aria-pressed','true');timer=setInterval(()=>{current++;render();},Number(lab.querySelector<HTMLSelectElement>('.speed')!.value));};
  button('play').onclick=play;lab.querySelector<HTMLSelectElement>('.speed')!.onchange=()=>{if(timer){stop();play();}};
  lab.querySelectorAll<HTMLButtonElement>('.dot').forEach(dot=>dot.onclick=()=>{stop();current=Number(dot.dataset.step);render();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();}).observe(lab);
  reduced.addEventListener('change',stop);compact.addEventListener('change',render);render();
});
</script>
<style>
.lab{background:#101d17;border:1px solid #3d5848;border-radius:22px;padding:24px;margin:28px 0}.lab-head{display:flex;justify-content:space-between;gap:10px;font:12px var(--mono);color:#9cbdac}.lab svg{width:100%;height:auto;margin:12px 0}.connection{stroke:#769987;stroke-width:2;fill:none}.scene-node rect{fill:#14271d;stroke:#3e5d4b;stroke-width:2;transition:fill .45s,stroke .45s}.scene-node.absent{opacity:.15}.scene-node.active rect{fill:#294a34;stroke:#b7ee91}.scene-node text{fill:#e3eee3;font:15px system-ui}.scene-node .node-value{fill:#b7ee91;font:13px var(--mono)}.packet{fill:#b7ee91;opacity:.6;transition:transform .65s}.caption{min-height:95px;padding:8px 0}.caption strong{font-size:22px;color:#d8f6bc}.caption p{margin:10px 0;line-height:1.6;color:#c1d0c5}.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.controls button,.controls select,.dot{min-height:44px;border:1px solid #4b6654;background:#14241b;color:#e7f0df;border-radius:8px;padding:8px 14px;font:14px system-ui;cursor:pointer}.controls button:disabled{opacity:.4;cursor:default}.controls label{display:flex;align-items:center;gap:8px;font-size:13px;margin-left:auto}.controls .play{background:#b7ee91;color:#102316;min-width:130px;font-weight:600}.timeline{display:flex;gap:8px;margin-top:20px}.dot{min-width:44px}.dot[aria-current]{background:#b7ee91;color:#102316}.model-note{font-size:12px;color:#a6b8aa;line-height:1.6;margin:16px 0 0}button:focus-visible,select:focus-visible{outline:3px solid #b7ee91;outline-offset:3px}@media(max-width:550px){.lab{padding:16px}.lab svg{min-height:130px}.scene-node text{font-size:16px}.controls label{margin:10px 0 0}.caption{min-height:120px}.caption strong{font-size:20px}.dot{padding:6px;min-width:38px}}@media(prefers-reduced-motion:reduce){.packet,.scene-node rect{transition:none}}
</style>
