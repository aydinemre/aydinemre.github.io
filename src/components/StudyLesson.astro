---
import StudyShell from '../layouts/StudyShell.astro';
import {loadWeek,slideHTML} from '../lib/study.js';
const {week}=Astro.props;const data=loadWeek(week),key=String(data.materialWeek).padStart(2,'0');
const config={week,materialWeek:data.materialWeek,data:'/study/cse513/data/week-'+key+'.json',hero:week===7||week>=11?'':'/study/cse513/assets/week-'+key+'.webp',extra:'/study/cse513/data/experiment-'+key+'.json'};
const forthcoming=[4,5,6,8,9,10].includes(week);
---
<StudyShell title={`CSE513 · Hafta ${week} · ${data.tr.title}`} description={data.tr.subtitle}>
<header slot="header"><div><a class="site-brand" href="/yuksek-lisans/bil513/" id="brand">CSE513 / HAFTA {week}</a><div id="subtitle" class="small">{data.tr.subtitle}</div></div><div class="header-controls"><a href="/yuksek-lisans/bil513/" id="course-back">Haftalar</a><label for="language">TR / EN <select id="language" aria-label="Türkçe / English"><option value="tr">Türkçe</option><option value="en">English</option></select></label><label for="jump"><span id="jump-label" class="small">Bölüm</span> <select id="jump">{data.slides.map((s,i)=><option value={i+1}>{String(i+1).padStart(2,'0')} · {s.tr.title}</option>)}</select></label></div></header>
<div class="progress" aria-hidden="true"></div><div class="layout"><aside><p id="contents-label">ÖĞRENME ROTASI</p><nav id="nav">{data.slides.map((s,i)=><a href={`#s${i+1}`} data-slide={i+1}><span>{String(i+1).padStart(2,'0')}</span>{s.tr.title}</a>)}</nav></aside><main id="main"><h1 id="study-title">{data.tr.title}</h1><div class="intro" id="intro"><p>Önce tahminini yaz. Deneyi adım adım ilerlet, sonra cevabın gerekçesini karşılaştır.</p>{forthcoming&&<p class="boundary">Bu hafta, yayımlanan resmî kapsamın birincil kaynaklarla geliştirilmiş özgün öğrenme uyarlamasıdır. Kaynak PDF henüz yayımlanmamıştı.</p>}</div><noscript><p class="boundary">Türkçe açıklamalar ve çözümler JavaScript kapalıyken de okunabilir. Dil seçimi ve deneyler için JavaScript gerekir.</p></noscript><div id="sections" set:html={data.slides.map((s,i)=>slideHTML(s,i,week)).join('')}></div><footer id="footer"><h2>Dosyalar ve kaynaklar</h2><p><a href={`/study/cse513/downloads/week-${key}.pptx`}>PowerPoint sunumu</a> · <a href="/yuksek-lisans/bil513/">Bütün haftalar</a></p></footer></main></div><div class="bottomnav"><a id="prev" href="#s1">Başlangıç</a><a id="next" href="#s2">Sonraki</a></div><script id="study-config" type="application/json" set:html={JSON.stringify(config).replace(/</g,'\\u003c')}></script><script is:inline type="module" src="/study/cse513/reader.js?v=20261007-gifs"></script>
</StudyShell>
