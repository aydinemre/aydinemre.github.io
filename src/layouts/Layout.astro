---
const { title = 'Emre Aydın', description = 'Kişisel notlarım, yüksek lisans çalışmalarım ve öğrenirken geliştirdiğim görsel anlatımlar.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === 'Emre Aydın' ? title + ' — Notlar & çalışmalar' : title + ' — Emre Aydın'}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path, Astro.site)}/><link rel="alternate" type="application/rss+xml" title="Emre Aydın — RSS" href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:url" content={new URL(path, Astro.site)}/><meta property="og:site_name" content="Emre Aydın"/><meta property="og:locale" content="tr_TR"/><meta name="twitter:card" content="summary"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={path.includes('kendini-tanimak') ? 'article' : 'website'}/></head>
<body><a class="skip" href="#icerik">İçeriğe geç</a><header><a class="brand" href="/">Emre Aydın<span>Notlar & çalışmalar</span></a><nav aria-label="Ana menü"><a href="/kisisel-notlarim/" aria-current={path.startsWith('/kisisel-notlarim') ? 'page' : undefined}>Kişisel Notlarım</a><a href="/yuksek-lisans/" aria-current={path.startsWith('/yuksek-lisans') ? 'page' : undefined}>Yüksek Lisans</a><a href="https://github.com/aydinemre">GitHub ↗</a></nav></header><main id="icerik"><slot/></main><footer><span>© {new Date().getFullYear()} Emre Aydın</span><span>Öğrenirken, düşünürken, yazarken.</span><a href="/rss.xml">RSS</a><a href="https://www.linkedin.com/in/emreeaydiinn/">LinkedIn ↗</a></footer></body></html>
<style is:global>
:root{color-scheme:dark;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#ecf2ed;background:#080d0b;font-synthesis:none;--muted:#a1b0a7;--border:#24342b;--accent:#a3ff78;--mono:ui-monospace,SFMono-Regular,Consolas,monospace}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 80% 0%,#13261c65,transparent 45%),#080d0b}a{color:inherit;text-underline-offset:5px}a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:6px}.skip{position:absolute;left:16px;top:-80px;background:#183323;padding:12px;z-index:10}.skip:focus{top:12px}header,main,footer{max-width:1280px;margin:auto;padding-left:48px;padding-right:48px}header{display:flex;justify-content:space-between;align-items:center;padding-top:28px;padding-bottom:28px;border-bottom:1px solid var(--border)}.brand{display:flex;gap:13px;align-items:center;text-decoration:none;font-size:17px;font-weight:650;letter-spacing:-.3px}.brand:before{content:'EA';display:grid;place-items:center;width:39px;height:39px;border:1px solid #537944;background:#a3ff7809;color:var(--accent);font:13px var(--mono);border-radius:5px}.brand span{display:none}nav{display:flex;gap:32px;font-size:13px;color:#bac6be}nav a{text-decoration:none;transition:color .2s}nav a:hover,nav a[aria-current]{color:var(--accent)}main{min-height:70vh;padding-top:70px;padding-bottom:100px}.eyebrow{display:inline-flex;align-items:center;gap:10px;font:11px var(--mono);letter-spacing:1.7px;text-transform:uppercase;color:var(--accent)}.eyebrow:before{content:'';width:6px;height:6px;background:var(--accent);box-shadow:0 0 12px #a3ff7870}.hero{max-width:800px;margin-bottom:64px}h1,h2,h3{font-weight:500;letter-spacing:-1.5px}h1{font-size:clamp(40px,5.8vw,76px);line-height:1.08;margin:24px 0 28px}h2{font-size:30px;line-height:1.25}h3{font-size:25px;line-height:1.3;margin:16px 0}.lead{font-size:17px;line-height:1.85;color:var(--muted);max-width:650px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.card{position:relative;display:block;overflow:hidden;border:1px solid var(--border);border-radius:10px;padding:34px;text-decoration:none;background:linear-gradient(140deg,#121b16,#0c130f);transition:border-color .25s,transform .25s,background .25s}.card:hover{border-color:#6f9d56;transform:translateY(-4px);background:linear-gradient(140deg,#17241a,#0c130f)}.card p{color:var(--muted);line-height:1.85;max-width:490px;font-size:15px}.card h2{margin:22px 0 16px}.card .link{display:inline-block;margin-top:15px;font:12px var(--mono);color:var(--accent)}.card:after{content:'↗';position:absolute;right:28px;top:26px;color:#8a9d90;font-size:22px}.section-title{display:flex;justify-content:space-between;align-items:center;margin-top:62px;margin-bottom:24px;gap:16px}.section-title h2{font-size:25px;margin:0}.section-title a{font:11px var(--mono);color:var(--accent)}.meta{color:var(--muted);font:12px var(--mono);line-height:1.7}.article{max-width:740px;margin:auto}.article h1{font-size:clamp(36px,4.8vw,57px);line-height:1.15}.article p,.article li{font-family:Georgia,serif;font-size:20px;line-height:1.95;color:#d0dbd3}.article p{margin:28px 0}.article .meta,.article .source{font-family:system-ui;font-size:14px;line-height:1.8;color:var(--muted)}.article .meta{margin-bottom:48px}.article .source{border-top:1px solid var(--border);margin-top:44px;padding-top:24px}.article a{color:var(--accent)}.back{display:inline-block;font:12px var(--mono);color:var(--muted);margin-bottom:16px}.empty{padding:30px;border:1px solid var(--border);border-left:2px solid var(--accent);border-radius:6px;background:#101c14;line-height:1.9;color:var(--muted)}.empty strong{color:#e0ebe1;font-weight:500}.course-code{font:13px var(--mono);letter-spacing:2px;color:var(--accent)}footer{display:flex;gap:24px;justify-content:space-between;border-top:1px solid var(--border);padding-top:30px;padding-bottom:35px;font:11px var(--mono);color:var(--muted)}footer a{text-decoration:none}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;border-radius:5px;background:var(--accent);color:#13200f;padding:16px 23px;font-size:13px;font-weight:650;text-decoration:none;transition:background .2s}.button:hover{background:#c4ffa8}.button.secondary{background:transparent;color:#dce6dd;border:1px solid #34483a}.actions{display:flex;gap:14px;margin-top:32px}.home-hero{position:relative;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:20px;min-height:520px;margin-bottom:65px}.home-hero h1{font-size:clamp(44px,5.7vw,78px);letter-spacing:-3.4px}.home-hero h1 em{font-style:normal;color:var(--accent)}.home-hero .lead{max-width:485px}.hero-bottom{display:flex;gap:30px;margin-top:38px;color:#87998b;font:10px var(--mono);letter-spacing:1px}.hero-bottom span:before{content:'+';color:var(--accent);margin-right:7px}.divider-label{display:flex;align-items:center;gap:20px;color:#8fa494;font:10px var(--mono);text-transform:uppercase;letter-spacing:2px;margin:0 0 28px}.divider-label:after{content:'';height:1px;flex:1;background:var(--border)}.diagram{height:64px;display:flex;align-items:center;gap:8px;margin-bottom:22px;color:#a3ff78}.diagram .node{width:39px;height:39px;border:1px solid #516848;border-radius:5px;display:grid;place-items:center;font:12px var(--mono);background:#192819}.diagram .line{height:1px;width:26px;background:#4a6042}.diagram .node.highlight{border-color:var(--accent);box-shadow:0 0 22px #a3ff7815}.entry{display:grid;grid-template-columns:170px 1fr auto;align-items:center;gap:28px}.entry h3{margin:0 0 12px;font-size:28px}.entry p{margin:0}.entry:after{display:none}.entry-number{font:50px var(--mono);color:#2c4735;letter-spacing:-5px}.entry .link{white-space:nowrap}.note-label{font:10px var(--mono);color:var(--accent);letter-spacing:1.4px;display:block;margin-bottom:18px}
@media(max-width:900px){header,main,footer{padding-left:28px;padding-right:28px}.home-hero{grid-template-columns:1fr;gap:10px}.home-hero h1{max-width:650px}.hero-art{max-width:550px;width:100%;margin:auto}.home-hero{margin-bottom:40px}.entry{grid-template-columns:1fr}.entry-number{display:none}.home-hero h1{letter-spacing:-2px}}
@media(max-width:600px){header,main,footer{padding-left:22px;padding-right:22px}header{align-items:flex-start;flex-direction:column;gap:23px;padding-top:22px;padding-bottom:22px}nav{gap:22px;flex-wrap:wrap;font-size:12px}main{padding-top:38px;padding-bottom:64px}.grid{grid-template-columns:1fr}.hero{margin-bottom:38px}.card{padding:26px}.home-hero h1{font-size:48px}.home-hero .lead{font-size:16px}.actions{flex-wrap:wrap}.hero-bottom{gap:16px;font-size:9px}.section-title{margin-top:42px}.section-title h2{font-size:22px}footer{flex-wrap:wrap;font-size:10px}.article p{font-size:18px}.article .meta{font-size:12px}.article h1{letter-spacing:-1px}.button{padding:14px 18px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.card:hover{transform:none}}
</style>