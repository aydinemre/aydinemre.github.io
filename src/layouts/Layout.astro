---
import ThemeHead from '../components/ThemeHead.astro';
import ThemeControl from '../components/ThemeControl.astro';
import MatrixMasthead from '../components/MatrixMasthead.astro';
const { title = 'Emre Aydın', description = 'Kişisel notlarım, yüksek lisans çalışmalarım ve öğrenirken geliştirdiğim görsel anlatımlar.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === 'Emre Aydın' ? title + ' — Notlar ve çalışmalar' : title + ' — Emre Aydın'}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path, Astro.site)}/><link rel="alternate" type="application/rss+xml" title="Emre Aydın — RSS" href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:url" content={new URL(path, Astro.site)}/><meta property="og:site_name" content="Emre Aydın"/><meta property="og:locale" content="tr_TR"/><meta name="twitter:card" content="summary"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={path.includes('kendini-tanimak') ? 'article' : 'website'}/><ThemeHead/><link rel="stylesheet" href="/site/blog.css?v=20261008-matrix"/></head>
<body><a class="skip" href="#icerik">İçeriğe geç</a><MatrixMasthead/><header><a class="brand" href="/">Emre Aydın<span>Notlar ve çalışmalar</span></a><nav aria-label="Ana menü"><a href="/kisisel-notlarim/" aria-current={path.startsWith('/kisisel-notlarim') ? 'page' : undefined}>Kişisel Notlarım</a><a href="/yuksek-lisans/" aria-current={path.startsWith('/yuksek-lisans') ? 'page' : undefined}>Yüksek Lisans</a><a href="https://github.com/aydinemre">GitHub ↗</a></nav><ThemeControl/></header><main id="icerik"><slot/></main><footer><span>© {new Date().getFullYear()} Emre Aydın</span><span>Kişisel notlar ve ders çalışmaları.</span><a href="/rss.xml">RSS</a><a href="https://www.linkedin.com/in/emreeaydiinn/">LinkedIn ↗</a></footer></body></html>
