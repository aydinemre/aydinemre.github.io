---
const { title = 'Emre Aydın', description = 'Kişisel notlarım, yüksek lisans çalışmalarım ve öğrenirken geliştirdiğim görsel anlatımlar.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === 'Emre Aydın' ? title + ' — Notlar & çalışmalar' : title + ' — Emre Aydın'}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path, Astro.site)}/><link rel="alternate" type="application/rss+xml" title="Emre Aydın — RSS" href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={path.includes('kendini-tanimak') ? 'article' : 'website'}/></head>
<body><a class="skip" href="#icerik">İçeriğe geç</a><header><a class="brand" href="/">Emre Aydın<span>Notlar & çalışmalar</span></a><nav aria-label="Ana menü"><a href="/kisisel-notlarim/" aria-current={path.startsWith('/kisisel-notlarim') ? 'page' : undefined}>Kişisel Notlarım</a><a href="/yuksek-lisans/" aria-current={path.startsWith('/yuksek-lisans') ? 'page' : undefined}>Yüksek Lisans</a><a href="https://github.com/aydinemre">GitHub ↗</a></nav></header><main id="icerik"><slot/></main><footer><span>© {new Date().getFullYear()} Emre Aydın</span><span>Öğrenirken, düşünürken, yazarken.</span><a href="/rss.xml">RSS</a><a href="https://www.linkedin.com/in/emreeaydiinn/">LinkedIn ↗</a></footer></body></html>
<style is:global>
:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#23372f;background:#faf8f2;font-synthesis:none;--muted:#65716a;--border:#dadfd4;--accent:#285b48}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}a:focus-visible,button:focus-visible{outline:3px solid #b87938;outline-offset:5px}.skip{position:absolute;left:16px;top:-70px;background:#fff;padding:12px;z-index:3}.skip:focus{top:12px}header,main,footer{max-width:1120px;margin:auto;padding-left:40px;padding-right:40px}header{display:flex;justify-content:space-between;align-items:center;padding-top:32px;padding-bottom:28px;border-bottom:1px solid var(--border)}.brand{font-family:Georgia,serif;font-size:27px;text-decoration:none;letter-spacing:-.8px}.brand span{display:block;font-family:system-ui;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;margin-top:6px;color:var(--muted)}nav{display:flex;gap:28px;font-size:14px}nav a{text-decoration:none}nav a:hover,nav a[aria-current]{color:var(--accent);text-decoration:underline}main{min-height:65vh;padding-top:64px;padding-bottom:80px}.eyebrow{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);font-weight:650}.hero{max-width:760px;margin-bottom:62px}h1,h2,h3{font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:-1px}h1{font-size:clamp(40px,6vw,68px);line-height:1.12;margin:18px 0 24px}h2{font-size:32px}h3{font-size:25px;line-height:1.3;margin:16px 0}.lead{font-size:19px;line-height:1.8;color:var(--muted);max-width:650px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.card{display:block;border:1px solid var(--border);border-radius:8px;padding:30px;text-decoration:none;background:#fffdf8;transition:border-color .2s,transform .2s}.card:hover{border-color:var(--accent);transform:translateY(-3px)}.card p{color:var(--muted);line-height:1.75}.card .link{font-size:14px;color:var(--accent)}.section-title{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);margin-top:55px;padding-top:20px}.section-title a{font-size:14px}.meta{color:var(--muted);font-size:13px}.article{max-width:720px;margin:auto}.article h1{font-size:clamp(36px,5vw,54px)}.article p,.article li{font-family:Georgia,serif;font-size:20px;line-height:1.9;color:#344138}.article .meta,.article .source{font-family:system-ui;font-size:14px;line-height:1.7;color:var(--muted)}.article .source{border-top:1px solid var(--border);margin-top:36px;padding-top:20px}.back{font-size:14px;color:var(--muted)}.empty{padding:30px;border-left:3px solid var(--accent);background:#eef1e7;line-height:1.8;color:#4f6056}.course-code{font-family:ui-monospace,monospace;font-size:13px;letter-spacing:1px;color:var(--accent)}footer{display:flex;gap:24px;justify-content:space-between;border-top:1px solid var(--border);padding-top:25px;padding-bottom:30px;font-size:12px;color:var(--muted)}@media(max-width:700px){header,main,footer{padding-left:22px;padding-right:22px}header{align-items:flex-start;flex-direction:column;gap:25px}nav{gap:20px;flex-wrap:wrap;font-size:13px}main{padding-top:42px}.grid{grid-template-columns:1fr}.hero{margin-bottom:40px}.card{padding:24px}footer{flex-wrap:wrap}.article p{font-size:18px}}@media(prefers-reduced-motion:reduce){.card{transition:none}.card:hover{transform:none}}
</style>