---
const { title = 'Emre Aydın', description = 'Kişisel notlarım, yüksek lisans çalışmalarım ve öğrenirken geliştirdiğim görsel anlatımlar.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === 'Emre Aydın' ? title + ' — Notlar ve çalışmalar' : title + ' — Emre Aydın'}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path, Astro.site)}/><link rel="alternate" type="application/rss+xml" title="Emre Aydın — RSS" href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:url" content={new URL(path, Astro.site)}/><meta property="og:site_name" content="Emre Aydın"/><meta property="og:locale" content="tr_TR"/><meta name="twitter:card" content="summary"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={path.includes('kendini-tanimak') ? 'article' : 'website'}/></head>
<body><a class="skip" href="#icerik">İçeriğe geç</a><div class="matrix-masthead" aria-hidden="true"><div class="matrix-glyphs"><span>0 1 0 1 1 0</span><span>1 0 1 0 0 1</span><span>0 0 1 1 0 1</span><span>1 1 0 0 1 0</span><span>0 1 1 0 1 0</span><span>1 0 0 1 0 1</span><span>0 1 0 1 0 0</span><span>1 0 1 1 0 1</span></div></div><header><a class="brand" href="/">Emre Aydın<span>Notlar ve çalışmalar</span></a><nav aria-label="Ana menü"><a href="/kisisel-notlarim/" aria-current={path.startsWith('/kisisel-notlarim') ? 'page' : undefined}>Kişisel Notlarım</a><a href="/yuksek-lisans/" aria-current={path.startsWith('/yuksek-lisans') ? 'page' : undefined}>Yüksek Lisans</a><a href="https://github.com/aydinemre">GitHub ↗</a></nav></header><main id="icerik"><slot/></main><footer><span>© {new Date().getFullYear()} Emre Aydın</span><span>Kişisel notlar ve ders çalışmaları.</span><a href="/rss.xml">RSS</a><a href="https://www.linkedin.com/in/emreeaydiinn/">LinkedIn ↗</a></footer></body></html>
<style is:global>
:root{color-scheme:dark;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#dce6dc;background:#090e0b;font-synthesis:none;--muted:#a7b5a8;--border:#34463a;--accent:#8fcf79;--serif:Georgia,"Times New Roman",serif;--mono:ui-monospace,SFMono-Regular,Consolas,monospace}*{box-sizing:border-box}::selection{background:#315b36;color:#f2fff2}.matrix-masthead{position:relative;max-width:1064px;height:62px;margin:auto;border-bottom:1px solid #28402d;overflow:hidden;pointer-events:none}.matrix-glyphs{display:flex;justify-content:flex-end;gap:14px;height:100%;padding-right:12px}.matrix-glyphs span{writing-mode:vertical-rl;text-orientation:upright;white-space:nowrap;color:#8fcf79;font:13px/1 var(--mono);letter-spacing:5px;opacity:.45}.matrix-glyphs span:nth-child(2n){transform:translateY(-20px);opacity:.65}.matrix-glyphs span:nth-child(3n){transform:translateY(-8px);opacity:.25}body{margin:0}a{color:var(--accent);text-underline-offset:5px}a:hover{text-decoration-thickness:2px}a:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.skip{position:absolute;left:16px;top:-80px;background:#17251b;padding:12px;z-index:10}.skip:focus{top:12px}header,main,footer{max-width:1160px;margin:auto;padding-left:48px;padding-right:48px}header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-top:26px;padding-bottom:26px;border-bottom:1px solid var(--border)}.brand{display:flex;flex-direction:column;justify-content:center;min-height:44px;text-decoration:none;color:#dce6dc;font-family:var(--serif);font-size:25px;line-height:1.3}.brand span{font-family:system-ui;font-size:14px;color:var(--accent);margin-top:4px}nav{display:flex;gap:24px;font:14px var(--mono)}nav a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;color:#dce6dc}nav a:hover,nav a[aria-current]{color:var(--accent);text-decoration:underline}main{min-height:70vh;padding-top:64px;padding-bottom:96px}h1,h2,h3{font-family:var(--serif);font-weight:400;letter-spacing:-.7px}h1{font-size:clamp(38px,4.5vw,60px);line-height:1.15;margin:14px 0 24px}h2{font-size:30px;line-height:1.25;margin:0 0 20px}h3{font-size:25px;line-height:1.3}.lead{font-size:19px;line-height:1.7;color:var(--muted);max-width:680px}.eyebrow,.meta{font-family:system-ui;font-size:14px;line-height:1.7;color:var(--muted)}.hero{max-width:780px;margin-bottom:50px}.intro{max-width:690px;margin-bottom:64px}.intro h1{font-size:32px;margin:0 0 10px}.intro .occupation{font-size:15px;color:var(--accent);margin:0 0 16px}.intro .lead{margin:0}.home-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(250px,1fr);gap:56px}.essay-feature h2{font-size:clamp(32px,3.5vw,44px);line-height:1.15;margin:20px 0}.essay-feature h2 a{color:#dce6dc;text-decoration:none}.essay-feature h2 a:hover{text-decoration:underline}.essay-feature p{font:20px/1.75 var(--serif);max-width:590px}.section-label{font:14px var(--mono);margin:0;color:var(--accent)}.read-link,.back{display:inline-flex;align-items:center;min-height:44px;font-size:15px}.course-index{border-left:1px solid var(--border);padding-left:32px}.course-index h2{font-size:26px;margin:0 0 24px}.course-row{display:block;text-decoration:none;border-top:1px solid var(--border);padding:22px 0;min-height:44px}.course-row:hover h3{text-decoration:underline}.course-row h3{font-size:22px;color:#dce6dc;margin:10px 0}.course-code{font:14px var(--mono);color:var(--accent)}.course-status{font-size:14px;line-height:1.6;color:var(--muted)}.course-list{max-width:800px}.course-list .course-row{display:grid;grid-template-columns:100px 1fr;gap:16px}.course-list h2{font-size:28px;margin:0 0 10px}.course-list p{margin:0}.notes-list{max-width:780px}.note-entry{padding:30px 0;border-top:1px solid var(--border)}.note-entry h2{font-size:35px;margin:15px 0}.note-entry h2 a{color:#dce6dc;text-decoration:none}.note-entry h2 a:hover{text-decoration:underline}.note-entry p{font:20px/1.75 var(--serif)}.article{max-width:680px;margin:auto}.article h1{font-size:clamp(36px,4.8vw,54px);line-height:1.15}.article p,.article li{font-family:var(--serif);font-size:20px;line-height:1.75}.article p{margin:28px 0}.article .meta,.article .source{font-family:system-ui;font-size:14px;line-height:1.8;color:var(--muted)}.article .meta{margin-bottom:44px}.article .source{border-top:1px solid var(--border);margin-top:44px;padding-top:24px}.back{margin-bottom:20px}.empty{max-width:680px;padding:28px 0;border-top:1px solid var(--border);line-height:1.8;color:var(--muted)}.empty strong{color:#dce6dc;font-weight:500}footer{display:flex;align-items:center;gap:24px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:22px;padding-bottom:26px;font-size:14px;color:var(--muted)}footer a{display:inline-flex;align-items:center;min-height:44px}footer span:nth-child(2){margin-right:auto}
@media(max-width:800px){.matrix-masthead{height:48px;margin:0 28px}.matrix-glyphs{gap:10px}header,main,footer{padding-left:28px;padding-right:28px}header{flex-direction:column;align-items:flex-start;gap:16px}.home-columns{grid-template-columns:1fr;gap:48px}.course-index{border-left:0;padding-left:0;padding-top:30px;border-top:1px solid var(--border)}.intro{margin-bottom:48px}main{padding-top:42px;padding-bottom:64px}}
@media(max-width:480px){.matrix-masthead{margin:0 22px}.matrix-glyphs span{font-size:12px}header,main,footer{padding-left:22px;padding-right:22px}nav{gap:18px;flex-wrap:wrap;font-size:14px}.course-list .course-row{grid-template-columns:1fr;gap:10px}.course-list h2{font-size:25px}.article p,.article li{font-size:19px}.article h1{font-size:38px}.essay-feature h2{font-size:35px}footer{gap:12px 22px}footer span:nth-child(2){flex-basis:100%;order:4}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
