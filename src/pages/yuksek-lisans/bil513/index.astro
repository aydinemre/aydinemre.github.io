---
import StudyShell from '../../../layouts/StudyShell.astro';
import {allWeeks,loadWeek} from '../../../lib/study.js';
const weeks=allWeeks.map(week=>{const d=loadWeek(week);return{week,title:d.tr.title,enTitle:d.en.title,subtitle:d.tr.subtitle,enSubtitle:d.en.subtitle,count:d.slides.length,type:d.kind||'lecture'};});
---
<StudyShell title="CSE513 · Bütün dönem" description="14 haftalık CSE513 çalışma rotası: Türkçe ve İngilizce notlar, gerçek hayat örnekleri, deneyler, ara sınav tekrarı ve makale sunumu rehberi."><main id="main" class="portal"><a class="back" href="/yuksek-lisans/" data-ui="back">← Yüksek lisans</a><p class="eyebrow">CSE513 / BİL513</p><h1 data-ui="title">İşletim sistemlerinde ileri konular</h1><p class="lead" data-ui="intro">Bütün dönem, tek öğrenme rotası. Önce tahmin et, adım adım dene, sonra teknik gerekçeyi açıkla.</p><p class="small" data-ui="schedule">14 hafta: 9 ders seti, bir ara sınav haftası ve dört makale sunumu haftası.</p><div class="week-list">{weeks.map(w=><section class="week-row"><div class="week-number">{String(w.week).padStart(2,'0')}</div><div><p class="eyebrow" data-week-kind={w.week}>{w.week===7?'KİŞİSEL TEKRAR':w.week>=11?'ORTAK SUNUM REHBERİ':`DERS SETİ ${w.week>7?w.week-1:w.week}`}</p><h2><a href={`/yuksek-lisans/bil513/hafta-${w.week}/`} data-week-title={w.week}>{w.title}</a></h2><p data-week-subtitle={w.week}>{w.subtitle}</p><a class="read-link" href={`/yuksek-lisans/bil513/hafta-${w.week}/`} data-ui="open">Çalışma sayfasını aç</a><span class="small count">{w.count} <span data-ui="sections">bölüm</span></span></div></section>)}</div><footer class="portal-footer"><h2 data-ui="sources">Kaynak ve kapsam</h2><p data-ui="scope">1–3. haftalar yayımlanan PDF’lerden yeniden anlatıldı. 4–6. ve 8–10. haftalar, PDF’leri henüz yayımlanmadığı için resmî kapsam ve birincil kaynaklardan özgün olarak geliştirildi.</p><p data-ui="practice">7. haftadaki tekrar resmî sınav kapsamı değildir. 11–14. haftalar ortak bir makale sunumu rehberini kullanır. Makale ve konuşma sırası atanmış gibi gösterilmez.</p><p><a href="https://mehmetgokturk.com/cse513/lectures.html" data-ui="official">Resmî ders takvimi</a> · <a href="https://mehmetgokturk.com/cse513/presentations.html" data-ui="presentation">Resmî sunum bilgileri</a></p></footer></main><script id="portal-weeks" type="application/json" set:html={JSON.stringify(weeks).replace(/</g,'\\u003c')}></script><script is:inline type="module" src="/study/cse513/portal.js"></script></StudyShell>
